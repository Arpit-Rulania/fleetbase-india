{
	frankenphp
	order php_server before file_server
}

http://:8000 {
	root * /fleetbase/api/public
	encode zstd gzip
	php_server {
		resolve_root_symlink
	}
}

http://:4200 {
	root * /fleetbase/console/dist
	encode zstd gzip

	# Never serve source-map files publicly (would expose unminified source).
	@sourcemaps path *.map
	respond @sourcemaps 404

	try_files {path} /
	file_server
}
