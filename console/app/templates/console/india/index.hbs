{{page-title "FleetIndia Overview"}}

<div class="fleetindia-panel p-4">
    <div class="mb-6">
        <h1 class="text-2xl font-semibold text-gray-900 dark:text-gray-100">FleetIndia</h1>
        <p class="mt-1 text-sm text-gray-600 dark:text-gray-300">
            India operations on top of Fleet-Ops. Existing Fleetbase features stay in their engines (Fleet-Ops, IAM, Ledger…).
            New private modules live here and talk to core-platform on port 3010.
        </p>
        <div class="mt-3 inline-flex items-center gap-2 rounded-md px-3 py-1 text-sm
            {{if @model.online "bg-emerald-50 text-emerald-800" "bg-amber-50 text-amber-800"}}">
            <span class="font-medium">core-platform</span>
            {{#if @model.online}}
                <span>online</span>
            {{else}}
                <span>unreachable — {{@model.error}}</span>
            {{/if}}
        </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        {{#each this.modules as |mod|}}
            <LinkTo @route={{mod.route}} class="block rounded-lg border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 p-4 hover:border-teal-500 transition">
                <div class="flex items-center gap-2 mb-2">
                    <FaIcon @icon={{mod.icon}} class="text-teal-600" />
                    <h2 class="text-lg font-medium">{{mod.title}}</h2>
                </div>
                <p class="text-sm text-gray-600 dark:text-gray-400">{{mod.blurb}}</p>
                <p class="mt-2 text-xs font-mono text-gray-400">{{mod.api}}</p>
            </LinkTo>
        {{/each}}
    </div>

    <div class="mt-8 rounded-lg border border-dashed border-gray-300 dark:border-gray-600 p-4 text-sm text-gray-600 dark:text-gray-400">
        <p class="font-medium text-gray-800 dark:text-gray-200 mb-1">Also available in this console</p>
        <p>Use the top nav for <strong>Fleet-Ops</strong> (orders, drivers, vehicles, live map), <strong>IAM</strong>, <strong>Developers</strong>, and other installed engines — those are the original platform features.</p>
    </div>
</div>
