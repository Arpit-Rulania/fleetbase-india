{{page-title "Analytics"}}
<div class="fleetindia-panel p-4 space-y-6">
  <header>
    <h1 class="text-2xl font-semibold">Analytics</h1>
    <p class="text-sm text-gray-500">Driver score = round(0.6×fuel + 0.4×safety) — <code class="text-xs">/api/analytics/*</code></p>
  </header>
  <section class="fi-card">
    <form {{on "submit" this.compute}} class="fi-form-grid">
      <Input @value={{this.driverUuid}} placeholder="Driver UUID" class="form-input" />
      <Input @value={{this.companyUuid}} placeholder="Company UUID (optional)" class="form-input" />
      <button type="submit" class="btn btn-primary btn-sm" disabled={{this.busy}}>Compute score</button>
      <button type="button" class="btn btn-default btn-sm" disabled={{this.busy}} {{on "click" this.latest}}>Latest score</button>
    </form>
    <form {{on "submit" this.rates}} class="fi-form-row mt-3">
      <Input @value={{this.corridor}} placeholder="Corridor e.g. Mumbai-Pune" class="form-input" />
      <button type="submit" class="btn btn-primary btn-sm" disabled={{this.busy}}>Rate stats</button>
    </form>
  </section>
  {{#if this.resultJson}}<pre class="fi-result">{{this.resultJson}}</pre>{{/if}}
</div>
