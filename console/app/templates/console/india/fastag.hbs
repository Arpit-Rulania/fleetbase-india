{{page-title "FASTag"}}
<div class="fleetindia-panel p-4 space-y-6">
  <header>
    <h1 class="text-2xl font-semibold">FASTag</h1>
    <p class="text-sm text-gray-500">Balances, top-ups, auto-recharge — <code class="text-xs">/api/fastag/*</code></p>
  </header>
  <section class="fi-card">
    <h2 class="fi-card-title">Accounts</h2>
    <form {{on "submit" this.loadAccounts}} class="fi-form-row">
      <Input @value={{this.companyUuid}} placeholder="Company UUID" class="form-input" />
      <button type="submit" class="btn btn-primary btn-sm" disabled={{this.busy}}>List</button>
    </form>
    <form {{on "submit" this.createAccount}} class="fi-form-grid mt-3">
      <Input @value={{this.companyUuid}} placeholder="Company UUID" class="form-input" />
      <Input @value={{this.vehicleUuid}} placeholder="Vehicle UUID" class="form-input" />
      <Input @value={{this.plateNumber}} placeholder="Plate" class="form-input" />
      <Input @value={{this.bankCode}} placeholder="Bank code" class="form-input" />
      <button type="submit" class="btn btn-primary btn-sm" disabled={{this.busy}}>Create account</button>
    </form>
  </section>
  <section class="fi-card">
    <h2 class="fi-card-title">Balance / recharge</h2>
    <form {{on "submit" this.checkBalance}} class="fi-form-row">
      <Input @value={{this.vehicleUuid}} placeholder="Vehicle UUID" class="form-input" />
      <button type="submit" class="btn btn-primary btn-sm" disabled={{this.busy}}>Balance</button>
    </form>
    <form {{on "submit" this.recharge}} class="fi-form-row mt-3">
      <Input @value={{this.vehicleUuid}} placeholder="Vehicle UUID" class="form-input" />
      <Input @value={{this.rechargeAmount}} placeholder="Amount ₹" class="form-input" @type="number" />
      <button type="submit" class="btn btn-primary btn-sm" disabled={{this.busy}}>Recharge</button>
    </form>
  </section>
  {{#if this.resultJson}}<pre class="fi-result">{{this.resultJson}}</pre>{{/if}}
</div>
